const fs = require('fs');
const path = require('path');
const { getFontStyleAndLinks } = require('./font-catalog');

// public/index.html은 요청마다 내용이 바뀌는 파일이 아니라(글자 하나까지 똑같은 정적
// 템플릿), 서버가 켜질 때 딱 한 번만 읽어서 메모리에 담아두고 재사용합니다.
// (요청이 올 때마다 디스크에서 다시 읽지 않아도 되니 더 빠릅니다)
const templatePath = path.join(__dirname, '..', 'public', 'index.html');
let template = fs.readFileSync(templatePath, 'utf-8');

function escapeHtml(str = '') {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

// 관리자 페이지 '메뉴 관리'에서 저장한 메뉴 목록으로 <nav> 링크들을 만듭니다.
// main.js도 같은 내용을 다시 한번 채워 넣지만(비어있지 않으면 그대로 덮어써도 눈에 티가
// 안 남), 여기서 서버가 미리 채워 보내는 이유는 페이지가 열리는 첫 순간부터 이미 메뉴가
// 자리 잡혀 있어서 "메뉴가 비어있다가 갑자기 나타나는" 어수선함이 없도록 하기 위함입니다.
function renderMenuLinks(menu = []) {
  return menu
    .map((m) => `<a href="${escapeHtml(m.link)}">${escapeHtml(m.label)}</a>`)
    .join('');
}

// 홈페이지 HTML을 완성해서 돌려줍니다. site.design(관리자가 고른 글씨체 설정)을
// </head> 바로 앞에 심고, menu(관리자가 등록한 메뉴 목록)를 <nav>에 직접 채워서,
// 방문자가 페이지를 받는 시점부터 이미 완성된 화면(글씨체 + 메뉴)이 그려지도록 합니다.
//
// 컨셉(A/B) 클래스도 같은 이유로 여기서 미리 심습니다. 큐티/칼럼 상세 페이지는 이미
// 이렇게 하고 있었는데, 홈페이지만 자바스크립트가 /api/site를 받아온 뒤에야
// <html>에 theme-b 클래스를 늦게 붙이고 있어서, 그 순간 화면(특히 글씨 크기)이
// 훅 바뀌어 보이는 문제가 있었습니다. site 데이터는 글씨체를 심을 때 이미 서버가
// 들고 있는 값이라, 컨셉 클래스를 같이 심는 데 추가 비용(네트워크·속도 저하)이 전혀
// 없습니다 — 글씨체가 느리게 반영되던 예전 문제와는 무관합니다.
// ---------------- 히어로(첫 화면) 미리 채우기 ----------------
// 예전에는 index.html에 적어 둔 고정 문구(예전 성경구절)가 먼저 보였다가, 잠시 뒤
// 자바스크립트가 관리자 페이지의 실제 문구로 바꿔 끼우면서 글씨·버튼이 크게 움직였습니다.
// 이제는 서버가 화면을 보낼 때부터 실제 문구(성경구절·출처·소개 문구)와 첫 배경 사진을
// 채워 넣어서, 처음 보이는 화면이 곧 최종 화면이 되도록 합니다.
// (public/js/main.js의 buildHeroVerseHtml과 똑같은 모양으로 만들어야 함)
function buildHeroVerseHtml(text = '') {
  return String(text)
    .split('\n')
    .map((line) => `<span class="verse-line">${escapeHtml(line.trim())}</span>`)
    .join('');
}

function heroFirstImage(hero = {}) {
  if (Array.isArray(hero.backgroundImages) && hero.backgroundImages.length) return hero.backgroundImages.find(Boolean) || '';
  return hero.backgroundImage || '';
}

function fillHero(html, site = {}) {
  const hero = site.hero;
  if (!hero) return html;
  const verse = hero.verse || '';
  let out = html
    .replace(
      /<p class="verse-text" id="hero-verse">[\s\S]*?<\/p>/,
      `<p class="verse-text" id="hero-verse" data-verse="${escapeHtml(verse)}">${buildHeroVerseHtml(verse)}</p>`
    )
    .replace(
      /<p class="verse-ref" id="hero-verse-ref">[\s\S]*?<\/p>/,
      `<p class="verse-ref" id="hero-verse-ref">${escapeHtml(hero.verseRef || '')}</p>`
    )
    .replace(
      /<p class="hero-subtitle" id="hero-subtitle">[\s\S]*?<\/p>/,
      `<p class="hero-subtitle" id="hero-subtitle">${escapeHtml(hero.subtitle || '').replace(/\n/g, '<br>')}</p>`
    );
  if (hero.overlayEnabled === false) {
    out = out.replace('<section class="hero" id="home">', '<section class="hero hero--no-overlay" id="home">');
  }
  // 첫 배경 사진: 처음부터 보이게 심고, 브라우저가 가장 먼저 받아오도록 미리 알려줌(preload)
  const img = heroFirstImage(hero);
  if (img && !/["'()\\]/.test(img)) {
    out = out
      .replace(
        '<div class="hero-bg-photo" id="hero-bg-photo-a"></div>',
        `<div class="hero-bg-photo is-visible" id="hero-bg-photo-a" style="background-image:url('${escapeHtml(img)}')"></div>`
      )
      .replace('</head>', `<link rel="preload" as="image" href="${escapeHtml(img)}">\n</head>`);
  }
  return out;
}

function renderIndexPage({ site, menu } = {}) {
  const { styleTag, extraLinks } = getFontStyleAndLinks(site?.design || {});
  const headInjected = `${extraLinks}\n${styleTag}\n</head>`;

  const menuHtml = renderMenuLinks(menu || []);
  const htmlOpenTag = site?.theme === 'b' ? '<html lang="ko" class="theme-b">' : '<html lang="ko">';

  return fillHero(template, site || {})
    .replace('<html lang="ko">', htmlOpenTag)
    .replace('</head>', headInjected)
    .replace('<nav class="nav-desktop" id="nav-desktop"></nav>', `<nav class="nav-desktop" id="nav-desktop">${menuHtml}</nav>`)
    .replace('<nav class="nav-mobile" id="nav-mobile"></nav>', `<nav class="nav-mobile" id="nav-mobile">${menuHtml}</nav>`);
}

module.exports = { renderIndexPage };
