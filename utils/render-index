const fs = require('fs');
const path = require('path');
const { getFontStyleAndLinks } = require('./font-catalog');

// public/index.html은 요청마다 내용이 바뀌는 파일이 아니라(글자 하나까지 똑같은 정적
// 템플릿), 서버가 켜질 때 딱 한 번만 읽어서 메모리에 담아두고 재사용합니다.
// (요청이 올 때마다 디스크에서 다시 읽지 않아도 되니 더 빠릅니다)
const templatePath = path.join(__dirname, '..', 'public', 'index.html');
let template = fs.readFileSync(templatePath, 'utf-8');

function escapeHtml(str = '') {
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

// 관리자 페이지 '메뉴 관리'에서 저장한 메뉴 목록으로 <nav> 링크들을 만듭니다.
// main.js도 같은 내용을 다시 한번 채워 넣지만(비어있지 않으면 그대로 덮어써도 눈에 티가
// 안 남), 여기서 서버가 미리 채워 보내는 이유는 페이지가 열리는 첫 순간부터 이미 메뉴가
// 자리 잡혀 있어서 "메뉴가 비어있다가 갑자기 나타나는" 어수선함이 없도록 하기 위함입니다.
function renderMenuLinks(menu = []) {
  return menu
    .map((m) => `<a href="${escapeHtml(m.link)}">${escapeHtml(m.label)}</a>`)
    .join('');
}

// 홈페이지 HTML을 완성해서 돌려줍니다. site.design(관리자가 고른 글씨체 설정)을
// </head> 바로 앞에 심고, menu(관리자가 등록한 메뉴 목록)를 <nav>에 직접 채워서,
// 방문자가 페이지를 받는 시점부터 이미 완성된 화면(글씨체 + 메뉴)이 그려지도록 합니다.
function renderIndexPage({ site, menu } = {}) {
  const { styleTag, extraLinks } = getFontStyleAndLinks(site?.design || {});
  const headInjected = `${extraLinks}\n${styleTag}\n</head>`;

  const menuHtml = renderMenuLinks(menu || []);

  return template
    .replace('</head>', headInjected)
    .replace('<nav class="nav-desktop" id="nav-desktop"></nav>', `<nav class="nav-desktop" id="nav-desktop">${menuHtml}</nav>`)
    .replace('<nav class="nav-mobile" id="nav-mobile"></nav>', `<nav class="nav-mobile" id="nav-mobile">${menuHtml}</nav>`);
}

module.exports = { renderIndexPage };
