// ---------------------------------------------------------------------------
// 서버(Node)에서 쓰는 글씨체 목록입니다. public/js/font-catalog.js(브라우저용 목록)와
// 항목이 같아야 합니다 — 새 폰트를 추가하실 땐 이 파일과 public/js/font-catalog.js를
// 함께 수정해주세요.
//
// 이 파일은 서버가 HTML을 직접 만들어 보낼 때(홈페이지, 큐티 상세 페이지) 관리자가
// 고른 글씨체를 페이지에 미리 반영해서, 방문자가 "기본 글씨체 → 설정한 글씨체"로
// 바뀌는 깜빡임을 보지 않도록 하는 데 쓰입니다.
// ---------------------------------------------------------------------------
const FONT_CATALOG = {
  'pretendard': { family: "'Pretendard', 'Noto Sans KR', sans-serif" }, // 별도 CDN으로 항상 로드됨
  'noto-sans-kr': { family: "'Noto Sans KR', sans-serif" }, // 기본 <link>로 항상 로드됨
  'noto-serif-kr': { family: "'Noto Serif KR', serif" }, // 기본 <link>로 항상 로드됨
  'gowun-dodum': { family: "'Gowun Dodum', sans-serif", google: 'Gowun+Dodum' },
  'gowun-batang': { family: "'Gowun Batang', serif", google: 'Gowun+Batang' },
  'nanum-gothic': { family: "'Nanum Gothic', sans-serif", google: 'Nanum+Gothic:wght@400;700;800' },
  'nanum-myeongjo': { family: "'Nanum Myeongjo', serif", google: 'Nanum+Myeongjo:wght@400;700;800' },
  'black-han-sans': { family: "'Black Han Sans', sans-serif", google: 'Black+Han+Sans' },
  'do-hyeon': { family: "'Do Hyeon', sans-serif", google: 'Do+Hyeon' },
  'song-myung': { family: "'Song Myung', serif", google: 'Song+Myung' },
  'poor-story': { family: "'Poor Story', cursive", google: 'Poor+Story' },
  'gothic-a1': { family: "'Gothic A1', sans-serif", google: 'Gothic+A1:wght@400;700;900' },
  'ibm-plex-sans-kr': { family: "'IBM Plex Sans KR', sans-serif", google: 'IBM+Plex+Sans+KR:wght@400;500;700' },
  'hahmlet': { family: "'Hahmlet', serif", google: 'Hahmlet:wght@400;600;700' },
  'jua': { family: "'Jua', sans-serif", google: 'Jua' },
  'sunflower': { family: "'Sunflower', sans-serif", google: 'Sunflower:wght@300;500;700' }
};

function getFontFamily(id, fallback) {
  const entry = FONT_CATALOG[id];
  return (entry && entry.family) || fallback;
}

// 기본 2종(노토 세리프/산스) + 프리텐다드 외의 폰트를 골랐을 때만, 그 폰트의 구글 폰트
// <link> 태그를 만들어줍니다. (기본 폰트는 이미 <head>에 항상 걸려있어 다시 안 만듭니다)
function getExtraFontLinkTag(id) {
  const entry = FONT_CATALOG[id];
  if (!entry || !entry.google) return '';
  return `<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=${entry.google}&display=optional">`;
}

// site.design(관리자가 저장한 글씨체 설정)을 받아서, HTML <head>에 그대로 삽입할 수 있는
// <style> 태그(CSS 변수 덮어쓰기)와, 필요하다면 추가 구글 폰트 <link> 태그를 만들어 돌려줍니다.
function getFontStyleAndLinks(design = {}) {
  const headingFontId = design.headingFont || 'noto-serif-kr';
  const bodyFontId = design.bodyFont || 'pretendard';
  const headingFamily = getFontFamily(headingFontId, "'Noto Serif KR', serif");
  const bodyFamily = getFontFamily(bodyFontId, "'Pretendard', 'Noto Sans KR', sans-serif");
  const extraLinks = [getExtraFontLinkTag(headingFontId), getExtraFontLinkTag(bodyFontId)]
    .filter(Boolean)
    .join('\n');
  const styleTag = `<style>:root{--font-heading:${headingFamily};--font-body:${bodyFamily};}</style>`;
  return { styleTag, extraLinks };
}

module.exports = { FONT_CATALOG, getFontFamily, getExtraFontLinkTag, getFontStyleAndLinks };
